{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rk-vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "73d00eaf-71a3-45e6-bcf6-37c94bcd97b8","database_name": "r2k-vpn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ff63003e5c32453d813c73183d9e0abc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
